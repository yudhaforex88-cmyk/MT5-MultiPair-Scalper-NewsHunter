#property strict\n#property version "1.20"\n#property description "MPNH scaffold; trading disabled; News monitor-only."\n#include <MPNH/Core/MPNH_Types.mqh>\n#include <MPNH/Core/MPNH_Logger.mqh>\n#include <MPNH/Core/MPNH_AccountState.mqh>\n#include <MPNH/Market/MPNH_MarketData.mqh>\n#include <MPNH/Risk/MPNH_RiskManager.mqh>\n#include <MPNH/News/MPNH_NewsMonitor.mqh>\n#include <MPNH/Execution/MPNH_ExecutionGateway.mqh>\n#include <MPNH/Protection/MPNH_Protection.mqh>\ninput bool InpEnableTrading=false; // keep false until validated\ninput string InpSymbols="EURUSD,GBPUSD,USDJPY,XAUUSD";\ninput ENUM_TIMEFRAMES InpExecutionTF=PERIOD_M5;\ninput int InpTimerSeconds=2;\ninput long InpMagic=26111101;\nCAccountState g_account; CMarketDataManager g_market; CRiskManager g_risk;\nCNewsMonitor g_news; CExecutionGateway g_execution; CProtectionManager g_protection;\nstring g_symbols[]; int g_symbol_count=0;\nint OnInit(){\n MPNH_Log(LOG_INFO,"MPNH","Initialize; entry disabled by default.");\n g_account.Init(false); g_risk.Init(); g_news.Init(); g_execution.Init(InpMagic); g_protection.Init(InpMagic);\n g_symbol_count=MPNH_ParseSymbols(InpSymbols,g_symbols); if(g_symbol_count<=0)return INIT_FAILED;\n for(int i=0;i<g_symbol_count;i++)if(!g_market.RegisterSymbol(g_symbols[i],InpExecutionTF))MPNH_Log(LOG_WARN,"MarketData","Register failed: "+g_symbols[i]);\n EventSetTimer(MathMax(1,InpTimerSeconds)); return INIT_SUCCEEDED;\n}\nvoid OnDeinit(const int reason){EventKillTimer(); MPNH_Log(LOG_INFO,"MPNH","Deinitialized.");}\nvoid OnTick(){g_protection.OnTick();}\nvoid OnTimer(){g_market.RefreshAll();g_news.Poll();g_account.Refresh();g_protection.OnTimer();if(InpEnableTrading&&g_account.EntryAllowed())MPNH_Log(LOG_WARN,"MPNH","No strategy implementation; orders remain disabled.");}\n