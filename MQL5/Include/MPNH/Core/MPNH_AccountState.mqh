#ifndef MPNH_ACCOUNT_STATE_MQH\n#define MPNH_ACCOUNT_STATE_MQH\n#include <MPNH/Core/MPNH_Types.mqh>\nclass CAccountState{private:MPNH_ACCOUNT_STATE m_state;bool m_enable;public:void Init(const bool enable){m_enable=enable;m_state=enable?ACCOUNT_READY:ACCOUNT_ENTRY_DISABLED;}void Refresh(){if(!m_enable)m_state=ACCOUNT_ENTRY_DISABLED;}bool EntryAllowed()const{return m_enable&&m_state==ACCOUNT_READY;}MPNH_ACCOUNT_STATE State()const{return m_state;}void SetState(const MPNH_ACCOUNT_STATE s){m_state=s;}};\n#endif\n