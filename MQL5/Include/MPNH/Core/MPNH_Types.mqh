#ifndef MPNH_TYPES_MQH\n#define MPNH_TYPES_MQH\nenum MPNH_LOG_LEVEL {LOG_DEBUG=0,LOG_INFO=1,LOG_WARN=2,LOG_ERROR=3};\nenum MPNH_ACCOUNT_STATE {ACCOUNT_READY=0,ACCOUNT_ENTRY_DISABLED,ACCOUNT_PROTECTION_ONLY,ACCOUNT_DAILY_LIMIT_REACHED,ACCOUNT_DRAWDOWN_LOCK,ACCOUNT_EXECUTION_ERROR,ACCOUNT_DATA_ERROR,ACCOUNT_EMERGENCY_LOCK};\nenum MPNH_NEWS_STATE {NEWS_NORMAL=0,NEWS_PRE_CAUTION,NEWS_ACTIVE_HIGH_RISK,NEWS_POST_OBSERVATION,NEWS_RECOVERY};\nenum MPNH_SIGNAL_STATE {SIGNAL_CREATED=0,SIGNAL_VALIDATED,SIGNAL_APPROVED,SIGNAL_REJECTED,SIGNAL_EXPIRED,SIGNAL_EXECUTED,SIGNAL_CANCELLED};\nstruct MPNH_MarketSnapshot {string symbol;ENUM_TIMEFRAMES timeframe;datetime bar_time;double bid,ask,point,spread_points;int digits;bool valid;};\nstruct MPNH_TradeProposal {string request_id,strategy_id,symbol;ENUM_ORDER_TYPE order_type;double volume,sl,tp,risk_percent;bool risk_approved;string risk_approval_id;};\nint MPNH_ParseSymbols(const string csv,string &out[]){string raw[];int n=StringSplit(csv,',',raw);ArrayResize(out,0);for(int i=0;i<n;i++){string s=raw[i];StringTrimLeft(s);StringTrimRight(s);if(StringLen(s)==0)continue;int k=ArraySize(out);ArrayResize(out,k+1);out[k]=s;}return ArraySize(out);}\n#endif\n