#ifndef MPNH_LOGGER_MQH\n#define MPNH_LOGGER_MQH\n#include <MPNH/Core/MPNH_Types.mqh>\ninput MPNH_LOG_LEVEL InpLogLevel=LOG_INFO;\nvoid MPNH_Log(const MPNH_LOG_LEVEL level,const string module,const string message){if(level<InpLogLevel)return;string p="[MPNH]["+module+"] ";if(level==LOG_ERROR)Print(p,"ERROR: ",message);else if(level==LOG_WARN)Print(p,"WARN: ",message);else if(level==LOG_DEBUG)Print(p,"DEBUG: ",message);else Print(p,message);}\n#endif\n