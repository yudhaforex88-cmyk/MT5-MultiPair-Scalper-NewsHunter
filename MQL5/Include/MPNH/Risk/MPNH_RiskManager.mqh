#ifndef MPNH_RISK_MANAGER_MQH\n#define MPNH_RISK_MANAGER_MQH\n#include <MPNH/Core/MPNH_Types.mqh>\n#include <MPNH/Core/MPNH_Logger.mqh>\nclass CRiskManager{public:void Init(){MPNH_Log(LOG_INFO,"Risk","Initialized fail-closed.");}bool Approve(MPNH_TradeProposal &p){p.risk_approved=false;p.risk_approval_id="";MPNH_Log(LOG_WARN,"Risk","Rejected: risk-budget implementation pending.");return false;}};\n#endif\n