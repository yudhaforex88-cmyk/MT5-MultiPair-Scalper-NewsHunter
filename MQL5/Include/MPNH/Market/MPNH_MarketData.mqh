#ifndef MPNH_MARKET_DATA_MQH\n#define MPNH_MARKET_DATA_MQH\n#include <MPNH/Core/MPNH_Types.mqh>\nclass CMarketDataManager{private:string m_symbols[];ENUM_TIMEFRAMES m_tf[];MPNH_MarketSnapshot m_data[];public:bool RegisterSymbol(const string sym,const ENUM_TIMEFRAMES tf){if(!SymbolSelect(sym,true))return false;int n=ArraySize(m_symbols);ArrayResize(m_symbols,n+1);ArrayResize(m_tf,n+1);ArrayResize(m_data,n+1);m_symbols[n]=sym;m_tf[n]=tf;m_data[n].symbol=sym;m_data[n].timeframe=tf;m_data[n].valid=false;return true;}void RefreshAll(){for(int i=0;i<ArraySize(m_symbols);i++)RefreshOne(i);}bool RefreshOne(const int i){if(i<0||i>=ArraySize(m_symbols))return false;MPNH_MarketSnapshot s;s.symbol=m_symbols[i];s.timeframe=m_tf[i];s.bid=SymbolInfoDouble(s.symbol,SYMBOL_BID);s.ask=SymbolInfoDouble(s.symbol,SYMBOL_ASK);s.point=SymbolInfoDouble(s.symbol,SYMBOL_POINT);s.digits=(int)SymbolInfoInteger(s.symbol,SYMBOL_DIGITS);s.bar_time=iTime(s.symbol,s.timeframe,1);s.spread_points=s.point>0?(s.ask-s.bid)/s.point:0;s.valid=s.bid>0&&s.ask>=s.bid&&s.point>0&&s.bar_time>0;m_data[i]=s;return s.valid;}bool GetSnapshot(const string sym,MPNH_MarketSnapshot &out){for(int i=0;i<ArraySize(m_symbols);i++)if(m_symbols[i]==sym){out=m_data[i];return out.valid;}return false;}int Count()const{return ArraySize(m_symbols);}};\n#endif\n