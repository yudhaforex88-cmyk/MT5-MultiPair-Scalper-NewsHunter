#ifndef MPNH_NEWS_MONITOR_MQH\n#define MPNH_NEWS_MONITOR_MQH\n#include <MPNH/Core/MPNH_Types.mqh>\n#include <MPNH/Core/MPNH_Logger.mqh>\n// MONITOR ONLY: deliberately no ExecutionGateway include or order functions.\nclass CNewsMonitor{private:MPNH_NEWS_STATE m_state;datetime m_poll;public:void Init(){m_state=NEWS_NORMAL;m_poll=0;MPNH_Log(LOG_INFO,"News","Monitor-only; no trade capability.");}void Poll(){// TODO: CalendarValueLast/change_id, revisions, normalization, state machine\nm_poll=TimeCurrent();}MPNH_NEWS_STATE State()const{return m_state;}datetime LastPoll()const{return m_poll;}};\n#endif\n